model WhatsAppTemplate {
  id String @id @default(uuid())

  name     String
  clientId String?

  templateId String?
  language   String
  category   String
  status     String

  body      String?
  variables Json?

  messages MessageQueue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  systemID       String?

  @@unique([name, language])
}
