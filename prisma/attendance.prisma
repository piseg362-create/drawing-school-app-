model Attendance {
  id           String           @id @default(uuid())
  instructorId String
  date         DateTime
  status       AttendanceStatus @default(NOT_TAKEN)
  note         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([instructorId, date])
  @@index([date])
  systemID       String?
}

enum AttendanceStatus {
  NOT_TAKEN
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}
