model WhatsAppToken {
  id                 String   @id @default(uuid())
  wabaId             String
  accessToken        String
  phoneNumberId      String
  status             String
  schoolId           String
  displayPhoneNumber String?
  verifiedName       String?
  safeMode           Boolean  @default(false)
  switchOffMode      Boolean  @default(false)
  monthlyBudget      Float    @default(150.0)
  utilityRate        Float    @default(0.15)
  defaultLanguage    String?  @default("en")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  systemID       String?
}
