model PaymentCycle {
  id            String         @id @default(uuid())
  instructorId  String
  month         DateTime
  amountTaken   Int            @default(0)
  baseAmount    Int
  deductions    Int
  bonus         Int
  netAmount     Int
  paidAt        DateTime
  note          String
  status        PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  instructor    Instructor     @relation(fields: [instructorId], references: [id])
  paymentsTaken PaymentTaken[]

  @@unique([instructorId, month])
  systemID       String?
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}
