model Student {
  id                  String    @id @default(uuid())
  name                String
  mobile              String
  packageId           String?
  package_name        String?
  Enrollment_status   String    @default("CHOSEN")
  Course_Start_date   DateTime?
  Course_End_Date     DateTime?
  Assigned_Instructor String?

  instructor Instructor? @relation(fields: [Assigned_Instructor], references: [id])
  car        Car?        @relation(fields: [Assigned_car_id], references: [id])

  Total_amount         Int
  Amount_paid          Int
  Remaining_percentage Int
  remaining_amount     Int

  Assigned_car_id String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  systemID        String?
  reminderDate    DateTime?
  licenseTestDate     DateTime?
  licenseTestTime     String?
  licenseTestLocation String?
  licenseTestStatus   String?   @default("SCHEDULED")
}
