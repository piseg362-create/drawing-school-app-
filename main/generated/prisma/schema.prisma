model PaymentTaken {
  id             String       @id @default(uuid())
  paymentCycleId String
  amount         Int
  takenAt        DateTime     @default(now())
  note           String
  paymentCycle   PaymentCycle @relation(fields: [paymentCycleId], references: [id])
  systemID       String?
}

model Attendance {
  id           String           @id @default(uuid())
  instructorId String
  date         DateTime
  status       AttendanceStatus @default(NOT_TAKEN)
  note         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  systemID     String?

  @@unique([instructorId, date])
  @@index([date])
}

enum AttendanceStatus {
  NOT_TAKEN
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

model CalendarEvent {
  id          String   @id @default(uuid())
  title       String
  date        String // Format: YYYY-MM-DD
  type        String   @default("TASK") // e.g. "HOLIDAY", "TASK", "SCHEDULE"
  description String?
  color       String? // Optional color for the UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  systemID    String?
}

model Car {
  id                  String  @id @default(uuid())
  name                String
  transmission        String
  assigned_instructor String?
  car_Number          String
  car_year            String

  updatedAt            DateTime              @updatedAt
  createdAt            DateTime              @default(now())
  students             Student[]
  instructors          Instructor[]
  maintenanceItem      MaintenanceItem[]
  maintenanceSchedules MaintenanceSchedule[]
  systemID             String?
}

model DemoStatus {
  id        String   @id @default(uuid())
  isDemo    Boolean  @default(true)
  startDate DateTime @default(now())
}

model SetupChecklist {
  id              String   @id @default(uuid())
  schoolSetup     Boolean  @default(false)
  instructorSetup Boolean  @default(false)
  carSetup        Boolean  @default(false)
  packageSetup    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  systemID        String?
}

model Instructor {
  id            String         @id @default(uuid())
  name          String
  mobile        String
  licenseNumber String?
  jobType       JobType        @default(INSTRUCTOR)
  joiningDate   DateTime?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payment       Float?         @default(0)
  paymentDate   Int?
  assignedCarId String?
  car           Car?           @relation(fields: [assignedCarId], references: [id])
  paymentCycles PaymentCycle[]
  students      Student[]
  systemID      String?
  accessToken   String?
  globalMongoId String?
}

enum JobType {
  INSTRUCTOR
  RECEPTION
}

model MaintenanceSchedule {
  id String @id @default(uuid())

  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  serviceDate DateTime
  notes       String?

  items MaintenanceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  systemID  String?
}

model MaintenanceItem {
  id String @id @default(uuid())

  maintenanceScheduleId String
  maintenanceSchedule   MaintenanceSchedule @relation(fields: [maintenanceScheduleId], references: [id], onDelete: Cascade)

  type            MaintenanceType
  intervalDays    Int?
  nextServiceDate DateTime?

  notes    String?
  car      Car?    @relation(fields: [carId], references: [id])
  carId    String?
  systemID String?
}

enum MaintenanceType {
  OIL_CHANGE
  OIL_FILTER
  AIR_FILTER
  TYRE_CHECK
  TYRE_REPLACEMENT
  BRAKE_CHECK
  BRAKE_PAD_REPLACEMENT
  BATTERY_CHECK
  BATTERY_REPLACEMENT
  ENGINE_CHECK
  COOLANT
  BRAKE_FLUID
  TRANSMISSION_FLUID
  AC_SERVICE
  WHEEL_ALIGNMENT
  WHEEL_BALANCING
  GENERAL_CHECKUP
  REPAIR
  CAR_WASH
  POLISHING
}

model Package {
  id       String  @id @default(uuid())
  name     String
  price    Decimal
  duration Int
  isActive Boolean @default(true)
  systemID String?
}

model PaymentCycle {
  id            String         @id @default(uuid())
  instructorId  String
  month         DateTime
  amountTaken   Int            @default(0)
  baseAmount    Int
  deductions    Int
  bonus         Int
  netAmount     Int
  paidAt        DateTime
  note          String
  status        PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  instructor    Instructor     @relation(fields: [instructorId], references: [id])
  paymentsTaken PaymentTaken[]
  systemID      String?

  @@unique([instructorId, month])
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Schedule {
  id            String  @id @default(uuid())
  student_id    String
  Batch_time    String
  Duration_time String
  Car_id        String
  systemID      String?
}

generator client {
  provider = "prisma-client-js"
  output   = "../main/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SchoolSetUp {
  id                         String   @id @default(uuid())
  school_name                String
  support_Email              String
  address                    String
  contact_Number             String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  systemID                   String?
  reminderDays               Int      @default(10)
  enableOnboardingMsg        Boolean  @default(true)
  enableReminderMsg          Boolean  @default(true)
  enableCompletionMsg        Boolean  @default(true)
  workingStartTime           String   @default("09:00")
  workingEndTime             String   @default("19:00")
  enableAttendanceReminder   Boolean  @default(true)
  reminderBeforeMinutes      Int      @default(60)
  lastAttendanceReminderDate String?
}

model Student {
  id                  String    @id @default(uuid())
  name                String
  mobile              String
  packageId           String?
  package_name        String?
  Enrollment_status   String    @default("CHOSEN")
  Course_Start_date   DateTime?
  Course_End_Date     DateTime?
  Assigned_Instructor String?

  instructor Instructor? @relation(fields: [Assigned_Instructor], references: [id])
  car        Car?        @relation(fields: [Assigned_car_id], references: [id])

  Total_amount         Int
  Amount_paid          Int
  Remaining_percentage Int
  remaining_amount     Int

  Assigned_car_id     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  systemID            String?
  reminderDate        DateTime?
  licenseTestDate     DateTime?
  licenseTestTime     String?
  licenseTestLocation String?
  licenseTestStatus   String?   @default("SCHEDULED")
}

model StudentAttendance {
  id        String   @id @default(uuid())
  studentId String
  date      DateTime
  status    String   @default("PRESENT") // PRESENT, ABSENT
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  systemID  String?

  @@unique([studentId, date])
  @@index([date])
}

model MessageQueue {
  id String @id @default(uuid())

  templateId String
  template   WhatsAppTemplate @relation(fields: [templateId], references: [id])

  recipient String
  variables Json

  status MessageQueueStatus @default(PENDING)

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  scheduledAt  DateTime  @default(now())
  processingAt DateTime?
  sentAt       DateTime?

  messageId String?
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  systemID  String?

  @@index([status])
  @@index([scheduledAt])
}

enum MessageQueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model WhatsAppTemplate {
  id String @id @default(uuid())

  name     String
  clientId String?

  templateId String?
  language   String
  category   String
  status     String

  body      String?
  variables Json?

  messages MessageQueue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  systemID  String?

  @@unique([name, language])
}

model WhatsAppToken {
  id                 String   @id @default(uuid())
  wabaId             String
  accessToken        String
  phoneNumberId      String
  status             String
  schoolId           String
  displayPhoneNumber String?
  verifiedName       String?
  safeMode           Boolean  @default(false)
  switchOffMode      Boolean  @default(false)
  monthlyBudget      Float    @default(150.0)
  utilityRate        Float    @default(0.15)
  defaultLanguage    String?  @default("en")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  systemID           String?
}
